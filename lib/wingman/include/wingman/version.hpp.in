#pragma once

#define WINGMAN_VERSION_MAJOR @PROJECT_VERSION_MAJOR@
#define WINGMAN_VERSION_MINOR @PROJECT_VERSION_MINOR@
#define WINGMAN_VERSION_PATCH @PROJECT_VERSION_PATCH@
#define WINGMAN_VERSION "@PROJECT_VERSION@"
// 展示用完整版本号（含 CI 构建后缀；正式版无后缀时与 WINGMAN_VERSION 相同）。
// 仅供人读输出（--version / 启动日志）；WINGMAN_VERSION 保持纯 semver，
// system.getVersion RPC 经它上报给 Go server，不掺构建后缀。
#define WINGMAN_VERSION_FULL "@PROJECT_VERSION@@WINGMAN_VERSION_FULL_SUFFIX@"
#define WINGMAN_VERSION_STRING "Wingman @PROJECT_VERSION@@WINGMAN_VERSION_FULL_SUFFIX@"
