[submodule "third_party/crashpad-cmake"]
	path = third_party/crashpad-cmake
	url = https://github.com/TheAssemblyArmada/crashpad-cmake.git
[submodule "third_party/crashpad"]
	path = third_party/crashpad
	url = https://github.com/backtrace-labs/crashpad.git
	ignore = untracked
[submodule "third_party/mini_chromium"]
	path = third_party/mini_chromium
	url = https://github.com/chromium/mini_chromium.git
[submodule "third_party/lss"]
	path = third_party/lss
	url = https://github.com/cpp-pm/linux-syscall-support.git
